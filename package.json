{
  "name": "bloommd-obsidian",
  "version": "0.5.1",
  "private": true,
  "description": "BloomMD companion plugin for Obsidian",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/main.ts src/styles.css --bundle --minify --external:obsidian --format=cjs --target=es2018 --outdir=. --entry-names=[name]",
    "release:verify": "node scripts/release.mjs --verify",
    "release:package": "bun run build && node scripts/release.mjs --package",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/markdown-document.test.ts src/canvas.test.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  }
}
