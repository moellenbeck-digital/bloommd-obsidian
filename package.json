{
  "name": "bloommd-obsidian",
  "version": "0.5.0",
  "private": true,
  "description": "BloomMD for Obsidian companion plugin",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/main.ts src/styles.css --bundle --minify --external:obsidian --format=cjs --target=es2018 --outdir=. --entry-names=[name]",
    "release:verify": "node scripts/release.mjs --verify",
    "release:package": "bun run build && node scripts/release.mjs --package",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/markdown-document.test.ts src/canvas.test.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "dagre": "^0.8.5",
    "lucide-react": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.0"
  }
}
